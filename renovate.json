{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "helpers:pinGitHubActionDigestsToSemver"],
  "schedule": ["on the first day of the month"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "rust crates",
      "groupSlug": "rust-crates"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker images",
      "groupSlug": "docker-images"
    },
    {
      "description": "Medusa's build tooling (medusa build / plugin:build) calls the TypeScript compiler API, which TypeScript 7 no longer ships. Hold the Medusa plugin and its e2e app on TypeScript 5.x until Medusa supports TypeScript 7.",
      "matchFileNames": ["plugins/medusa/**"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6"
    }
  ]
}
