# Copy to .env next to compose.yml and fill in. Keep .env private: it holds the webhook secret.

# The public host name for the pay page. Point its DNS A/AAAA records at this server.
PAY_DOMAIN=pay.shop.example

# The image tag to run. Pin a version or commit tag for predictable upgrades.
IMAGE_TAG=main

# mainnet or testnet.
ZCASH_NETWORK=mainnet
# The wallet's unified incoming viewing key (it can see payments, not spend them).
ZCASH_UIVK=
# The block height the wallet was created at; scanning starts there.
ZCASH_BIRTHDAY_HEIGHT=
# A lightwalletd server for the network.
LIGHTWALLETD_URL=

# Where to send payment webhooks (your store), and a long random secret shared with it:
#   openssl rand -hex 32
ZCASH_WEBHOOK_URL=
ZCASH_WEBHOOK_SECRET=
# Confirmations before a payment is reported; 0 includes mempool receipts. See book/src/woocommerce.md#setup.
WEBHOOK_REPORT_CONFIRMATIONS=0

# Your store's origin(s), comma-separated. The pay page only returns customers to these.
# Leaving it empty allows any return URL.
RETURN_URL_ALLOWED_ORIGINS=https://shop.example

# Where the private API (creating payment sessions) listens. The default, 127.0.0.1, suits a
# store on this same server. For a store elsewhere, use this server's private-network or VPN
# address, never a public one: the private API has no authentication.
PRIVATE_API_BIND=127.0.0.1
PRIVATE_API_PORT=8787

# Leave these alone in production.
TLS_MODE=acme
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
PUBLIC_HTTPS_PORT_SUFFIX=
ZCASH_DEV_SIMULATED_PAYMENTS=false
